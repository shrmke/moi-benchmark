# Copy to .local-services/fastgpt_local/fastgpt.env for non-secret runtime
# overrides. All API keys live in the repository-root .env.
FASTGPT_BASE_URL=http://127.0.0.1:3000
# FASTGPT_API_KEY lives in the root .env.
FASTGPT_APP_ID=<local-fastgpt-app-id>
FASTGPT_LLM_PROVIDER=deepseek-official
FASTGPT_EMBEDDING_PROVIDER=maas

# DeepSeek official text-generation channel.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY_NEW lives in the root .env.
DEEPSEEK_CHANNEL_NAME='DeepSeek Official'
DEEPSEEK_LLM_MODEL=deepseek-v4-flash

# Huawei Cloud MaaS embedding-only channel (CN Southwest-Guiyang-1).
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
# MAAS_API_KEY lives in the root .env.
MAAS_CHANNEL_NAME='Huawei Cloud MaaS embedding'
MAAS_EMBEDDING_ONLY=1
MAAS_EMBEDDING_MODEL=bge-m3

# Legacy TaaS/Qianfan templates are retained in
# legacy_provider_contracts.json, but are not active in this file or campaign.

# Smoke defaults. Keep the source directory read-only.
FASTGPT_SMOKE_SOURCE_DIR=local-rag-platforms/fixtures/smoke
FASTGPT_SMOKE_QUESTION='What facts are stated in the local smoke documents?'
FASTGPT_SMOKE_RETRIEVAL_QUERY='local RAG smoke'
FASTGPT_SMOKE_WAIT_SECONDS=300
