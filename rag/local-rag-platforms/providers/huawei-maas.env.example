# Huawei Cloud MaaS, CN Southwest-Guiyang-1.
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
# MAAS_API_KEY is defined only in the repository-root .env.
MAAS_LLM_MODEL=glm-5.2
# The current MOI benchmark is text-only; no vision model is selected.
MAAS_VL_MODEL=NOT_APPLICABLE
MAAS_EMBEDDING_MODEL=bge-m3
MAAS_EMBEDDING_DIMENSION=1024
MAAS_RERANKER_MODEL=
