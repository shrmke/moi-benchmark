# Copy to .local-services/maxkb_local/runtime.env and chmod 600.
# Never commit or paste real credentials into reports/artifacts. API keys are
# centralized in the repository-root .env.
# Current MOI text-only benchmark provider records:
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
# MAAS_API_KEY lives in the root .env.
MAAS_CHAT_MODEL=glm-5.2
MAAS_LLM_MODEL=glm-5.2
MAAS_EMBEDDING_MODEL=bge-m3
MAAS_EMBEDDING_DIMENSION=1024
MAAS_RERANKER_MODEL=

# MaxKB evaluation selection. The embedding model record is created/verified
# by: maxkb-local.sh maas-models register --execute
MAXKB_BASE_URL=http://127.0.0.1:8090
MAXKB_ADMIN_BASE_URL=http://127.0.0.1:8090/admin/api
MAXKB_ADMIN_TOKEN_FILE=.local-services/maxkb_local/secrets/admin.token
MAXKB_EMBEDDING_PROVIDER=maas
MAXKB_EMBEDDING_MODEL_NAME=bge-m3
MAXKB_LLM_MODEL_NAME=glm-5.2
MAXKB_EMBEDDING_DIMENSION=1024
# Optional after registration; competitor_eval_runner can discover by name.
MAXKB_EMBEDDING_MODEL_ID=
MAXKB_LLM_MODEL_ID=
MAXKB_CHAT_MODEL_ID=

# Rotate the official initial password in the UI; this placeholder is optional.
MAXKB_ADMIN_NEW_PASSWORD=<local-password-manager-value>

# MaxKB 2.10.4 native GLM thinking persistence is unproven; the current runner
# uses admin hit_test retrieval plus external MaaS generation instead of this
# legacy published-agent path. The external path carries thinking=disabled.
MAXKB_EXTERNAL_MAX_CHUNKS=64
MAXKB_EXTERNAL_CONTEXT_CHARS=16000
