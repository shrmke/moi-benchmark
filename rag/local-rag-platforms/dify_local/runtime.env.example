# Local Dify application credentials.
DIFY_API_BASE_URL=http://127.0.0.1:8010/v1
# DIFY_LOCAL_DATASET_API_KEY and DIFY_LOCAL_API_KEY live in the root .env.
DIFY_LOCAL_APP_ID=<local-app-id>
DIFY_LOCAL_DATASET_ID=<local-dataset-id>

# Current MOI text-only benchmark contract. Install the repository-owned
# matrixorigin-huawei-maas.difypkg package, then select this exact provider ID
# in the local Dify model registry.
MAAS_BASE_URL=https://api.modelarts-maas.com/v1
# MAAS_API_KEY lives in the root .env.
MAAS_LLM_MODEL=glm-5.2
MAAS_EMBEDDING_MODEL=bge-m3
MAAS_EMBEDDING_DIMENSION=1024
MAAS_RERANKER_MODEL=
DIFY_MAAS_LLM_PROVIDER=matrixorigin/matrixorigin_huawei_maas/huawei_maas
DIFY_MAAS_EMBEDDING_PROVIDER=matrixorigin/matrixorigin_huawei_maas/huawei_maas

# Legacy Qianfan/TaaS variables are intentionally absent from this active
# template. They belong to historical smoke records, not this benchmark.
