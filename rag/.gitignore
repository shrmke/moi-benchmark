# Local CodeGraph index and daemon state.
.codegraph/

# Python packaging metadata generated by editable/build installs.
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/

/taas*.py
weekly*.md
.env
*.difypkg
runs/
outputs/
!/scripts/
!/scripts/benchmarks/
!/scripts/benchmarks/**
!/tests/
!/tests/benchmarks/
!/tests/benchmarks/**
tmp/
/.local-services/
~$*.xlsx

datasets/
.docs/
tests/benchmarks/__pycache__/
# benchmarks/
tests/
!local-rag-platforms/tests/
local-rag-platforms/tests/*
!local-rag-platforms/tests/test_competitor_eval_judge.py
!local-rag-platforms/tests/test_competitor_eval_metrics.py
# local-rag-platforms/

# Large generated benchmark payloads (>10 MB) stay local; smaller JSON/JSONL
# artifacts, Markdown reports, and READMEs remain uploadable.
/results/metrics/*/judge-input.jsonl
/results/metrics/*/results.jsonl
docs/refs/

results/.cache/
plans
